# Copy this file to .env, then run python3 scripts/setup-security.py.
# Leave generated keys private; never commit .env.
ARK_INTERNAL_KEY=
ARK_SETUP_TOKEN=
ARK_PUBLIC_ORIGIN=http://localhost:8080
ARK_COOKIE_SECURE=false
# Required for public deployment: HTTPS origin and ARK_COOKIE_SECURE=true.
# DB_PASSWORD must match existing database users; changing this variable alone does not rotate a database password.
# GRAFANA_PASSWORD is generated by setup-security.py; existing Grafana data needs an explicit password reset.
